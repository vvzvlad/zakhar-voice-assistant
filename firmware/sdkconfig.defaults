CONFIG_IDF_TARGET="esp32s3"

# ESP32-S3R8 with a 16 MB quad flash; the ESPHome partition layout (partitions.csv).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# A new image is kept once it has run a minute with an IP or taken an upload; one that crashes
# first, or is not up with an IP and provisioning ended in 120 s and restarts, boots the previous
# image again (app_main.c).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# 8 MB octal PSRAM in the package: the microphone tap, the playback buffer, the model arenas.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# The stock firmware runs micro_wake_word at the highest clock (ESPHome's default for the S3).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# The stock caches and the stock pair that copies code and read-only data into PSRAM at boot
# (home-assistant-voice.yaml: "considerably speeds up mWW"); code then also runs while the flash
# is being written.
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# 1 ms ticks: the LED effects keep the stock millisecond timings.
CONFIG_FREERTOS_HZ=1000

# As the stock firmware: the I2S interrupts keep running while the flash is written (NVS, OTA).
CONFIG_I2S_ISR_IRAM_SAFE=y

# BLE provisioning (main/app_main.c): NimBLE with its allocations in PSRAM, protocomm security 1
# only (the device sends no proof of possession, so the app asks for no code).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_0 is not set
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y
# CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_2 is not set

# Both microphone channels stream at 64 KB/s over one TCP connection. The default 5760-byte send
# buffer holds under three frames: after one lost segment too little follows it for a fast
# retransmit, and the stream waits out the retransmission timeout.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
# Wi-Fi and lwIP buffers in PSRAM first. Next to the stop word's echo canceller the internal heap
# fell to 127-307 B free and, while the speaker played, its largest block to 1.5 KB: frames larger
# than that were dropped and the link to the server broke every ~15 s.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# That option alone raises the Wi-Fi defaults: static RX buffers 10 -> 16, internal RAM taken at
# Wi-Fi init (~1.6 KB each), and the RX block-ack window 6 -> 16. Booted with them, the speaker had
# 5 KB of internal RAM left and could not create the WebSocket task. The previous values:
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_RX_BA_WIN=6
# The mDNS task's stack and its packets in PSRAM: at boot no internal block was left for the 4 KB
# stack ("failed to allocate memory for the mDNS task's stack") and the link to the server never
# started.
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
# A plain malloc() under this many bytes prefers internal RAM, a larger one PSRAM (ESP-IDF's
# default is 16384). Task stacks and DMA buffers ask for internal RAM by caps and stay there.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# The Sendspin music player (main/music.cpp): the player role alone, FLAC and PCM.
CONFIG_SENDSPIN_ENABLE_PLAYER=y
# CONFIG_SENDSPIN_ENABLE_OPUS is not set
# CONFIG_SENDSPIN_ENABLE_CONTROLLER is not set
# CONFIG_SENDSPIN_ENABLE_METADATA is not set
# CONFIG_SENDSPIN_ENABLE_COLOR is not set
# CONFIG_SENDSPIN_ENABLE_ARTWORK is not set
# CONFIG_SENDSPIN_ENABLE_VISUALIZER is not set
# CONFIG_SENDSPIN_ENABLE_SOURCE is not set

# The zero-initialised statics of lwip, net80211, pp, wpa_supplicant and bt (ESP-IDF moves these
# libraries' .bss with this option) and of the music player's library (main/music.lf) in PSRAM,
# ~14 KB: with the player running, internal RAM had no 6 KB block left for the link's WebSocket
# task stack.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Sockets open at once: POST /ota's server 3 of its own and the upload, the Sendspin server 3 and
# up to 4 connections, the network log's listener and its client (two while a new one replaces the
# old), the zakhar_link connection. The socket table is in PSRAM with the lwip .bss above.
CONFIG_LWIP_MAX_SOCKETS=16
