menu "zakhar"

config ZAKHAR_DEVICE_ID
    string "Device id (hello.id, the device name in the server config)"
    default "main_room"

config ZAKHAR_SERVER_URL
    string "Server WebSocket URL"
    default "ws://10.31.41.59:8200/device"

config ZAKHAR_WIFI_SSID
    string "Wi-Fi SSID of the one-time seed image"
    default ""
    help
        Set only in the image of `make fw-build-seed` (from sdkconfig.secrets). A device with no
        stored network stores this one and connects; empty, it starts BLE provisioning.

config ZAKHAR_WIFI_PASSWORD
    string "Wi-Fi password of the one-time seed image"
    default ""

endmenu
